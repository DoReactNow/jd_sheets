# The local full stack (docker-compose.local.yml, profile "full"). Development values only:
# the placeholders below are refused in production. Never put real secrets here.
APP_ENV=development
APP_URL=http://127.0.0.1:47324
APP_PORT=47320
LOG_LEVEL=info
DATABASE_URL=postgresql://jdsheets:jdsheets@db:5432/jdsheets_dev
DEV_PRINCIPAL=on
NETWORK_ENFORCEMENT=off
TRUSTED_PROXY_HOPS=1
COLLAB_URL=http://collab:47321
COLLAB_HOST=0.0.0.0
COLLAB_PORT=47321
COLLAB_TOKEN_SECRET=dev-only-collab-secret-change-me-0123456789
INTERNAL_SERVICE_TOKEN=dev-only-internal-token-change-me-0123456789
WORKBOOK_VALIDATOR=collab
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/workbooks
MAIL_DRIVER=fake
