{
  "name": "jd-sheets",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev .env",
    "dev:all": "concurrently -k -n app,worker,collab -c blue,magenta,yellow \"npm:dev\" \"npm:worker:dev\" \"npm:collab:dev\"",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --packages=external --outfile=dist/worker.js",
    "start": "node scripts/run-next.mjs start .env",
    "start:test": "node scripts/run-next.mjs start .env.test",
    "worker:dev": "dotenv run -q --override -f .env -- tsx watch src/worker/index.ts",
    "worker:start": "node dist/worker.js",
    "collab:dev": "node scripts/rust.mjs run .env",
    "collab:test-start": "node scripts/rust.mjs run-release .env.test",
    "lint": "npm run lint:code && npm run lint:arch && npm run format:check && npm run guard:files",
    "guard:files": "node scripts/check-forbidden-files.mjs",
    "lint:code": "eslint .",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "setup:rust": "node scripts/setup-rust.mjs",
    "editor:build": "node scripts/editor-build.mjs",
    "editor:serve": "node scripts/editor-serve.mjs",
    "editor:test": "node scripts/editor-test.mjs",
    "rust:check": "node scripts/rust.mjs check",
    "rust:build": "node scripts/rust.mjs build",
    "rust:test": "node scripts/rust.mjs test .env.test",
    "rust:ci": "npm run rust:check && npm run rust:build && npm run rust:test",
    "test:unit": "vitest run --project unit --project unit-dom && npm run test:unit:tz",
    "test:unit:tz": "cross-env TZ=UTC vitest run --project unit src/shared/time && cross-env TZ=America/Los_Angeles vitest run --project unit src/shared/time",
    "test:integration": "npm run db:test:prepare && vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:e2e": "npm run db:test:prepare && node scripts/e2e-servers.mjs start && (playwright test; status=$?; node scripts/e2e-servers.mjs stop; exit $status)",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract",
    "test:watch": "vitest --project unit --project unit-dom",
    "ci:quality": "npm run lint && npm run typecheck && npm run build && npm run build:worker && npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e",
    "db:up": "docker compose -f docker/docker-compose.local.yml up -d db",
    "db:down": "docker compose -f docker/docker-compose.local.yml down",
    "db:generate": "prisma generate",
    "db:migrate:dev": "dotenv run -q --override -f .env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv run -q --override -f .env -- prisma migrate deploy",
    "db:migrate:check": "npm run db:test:migrate && dotenv run -q --override -f .env.test -- prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:test:migrate": "dotenv run -q --override -f .env.test -- prisma migrate deploy",
    "db:test:prepare": "tsx scripts/prepare-test-db.ts",
    "db:seed:dev": "dotenv run -q --override -f .env -- tsx prisma/seed-dev.ts",
    "db:seed:test": "dotenv run -q --override -f .env.test -- tsx prisma/seed-test.ts",
    "db:reset:dev": "tsx scripts/reset-db.ts .env",
    "db:reset:test": "tsx scripts/reset-db.ts .env.test",
    "contracts:generate": "tsx scripts/generate-contracts.ts && prettier --write contracts",
    "docker:full:up": "docker compose -f docker/docker-compose.local.yml --profile full up -d --build --wait",
    "docker:full:down": "docker compose -f docker/docker-compose.local.yml --profile full down",
    "docker:check": "node scripts/docker-check.mjs",
    "db:sync-rbac": "dotenv run -q --override -f .env -- tsx src/modules/identity/identity.cli.ts sync-rbac",
    "admin:reset-super-admin": "dotenv run -q --override -f .env -- tsx src/modules/identity/identity.cli.ts reset-super-admin",
    "admin:reset-ip-rules": "dotenv run -q --override -f .env -- tsx src/modules/network/network.cli.ts reset-ip-rules",
    "db:seed:private": "dotenv run -q --override -f .env -- tsx prisma/seed-private.ts",
    "worker:test-start": "dotenv run -q -f .env.test -- node dist/worker.js"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "6.2.15",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.0",
    "dotenv": "18.0.9",
    "dotenv-cli": "11.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
