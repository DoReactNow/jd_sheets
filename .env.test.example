# Test environment (local_setup.md Section 3). Copy to .env.test. Used only by tests.
APP_ENV="test"
APP_URL="http://127.0.0.1:47330"
APP_HOST="127.0.0.1"
APP_PORT="47330"
LOG_LEVEL="warn"

# Must end in _test; the app and the Rust service refuse anything else.
DATABASE_URL="postgresql://jdsheets:jdsheets@127.0.0.1:47322/jdsheets_test"

NETWORK_ENFORCEMENT="off"
TRUSTED_PROXY_HOPS="1"

COLLAB_URL="http://127.0.0.1:47331"
COLLAB_HOST="127.0.0.1"
COLLAB_PORT="47331"
COLLAB_TOKEN_SECRET="test-only-collab-secret-0123456789abcdef"
INTERNAL_SERVICE_TOKEN="test-only-internal-token-0123456789abcdef"

# Unit and integration tests use the fake validator; contract and E2E tests start the real service.
WORKBOOK_VALIDATOR="fake"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/test"
MAIL_DRIVER="fake"

AUTH_SECRET="test-only-auth-secret-0123456789abcdef0123"
BOOTSTRAP_ALLOWED_CIDRS="127.0.0.1/32,::1/128"

# Throwaway passwords used only by prisma/seed-test.ts and the tests.
TEST_USER_PASSWORD="Test-Pass-2027!x"
