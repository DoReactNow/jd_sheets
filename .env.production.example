# Production environment (local_setup.md Section 3). Copy to .env.production ON THE SERVER ONLY.
# Every <...> value must be replaced; the app refuses to start otherwise.
APP_ENV="production"
APP_URL="<https://your-domain>"
APP_HOST="0.0.0.0"
APP_PORT="47320"
LOG_LEVEL="info"

# Must NOT end in _test
DATABASE_URL="<postgresql://user:password@db:5432/jdsheets>"
POSTGRES_PASSWORD="<database password>"

DEV_PRINCIPAL="off"
NETWORK_ENFORCEMENT="on"
TRUSTED_PROXY_HOPS="1"
EDGE_ALLOWED_CIDRS="<office CIDRs, comma-separated>"
BOOTSTRAP_ALLOWED_CIDRS="<office CIDRs, comma-separated>"

COLLAB_URL="http://collab:47321"
COLLAB_HOST="0.0.0.0"
COLLAB_PORT="47321"
# Generate each with: openssl rand -base64 48
COLLAB_TOKEN_SECRET="<random secret>"
INTERNAL_SERVICE_TOKEN="<random secret>"

WORKBOOK_VALIDATOR="collab"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/data/workbooks"

MAIL_DRIVER="smtp"
