# The edge (Decisions 18, 34). Locally: plain http on :47324. In production: {$SITE_ADDRESS} is
# the domain, and Caddy gets HTTPS certificates by itself.
{$SITE_ADDRESS::80} {
	# Layer 1 of the IP allowlist: everyone outside these ranges sees a static page (403).
	@outside not remote_ip {$EDGE_ALLOWED_CIDRS:0.0.0.0/0 ::/0}
	handle @outside {
		root * /srv/blocked
		rewrite * /index.html
		file_server {
			status 403
		}
	}

	# Internal endpoints are for the services on the private network only.
	@internal path /api/internal/* /internal/*
	respond @internal "Not found" 404

	# Live collaboration (Phase 3).
	handle /collab/* {
		reverse_proxy collab:47321
	}

	handle {
		reverse_proxy app:47320
	}

	encode zstd gzip
	header -Server
	log {
		output stdout
		format json
	}
}
