# Production environment (local_setup.md Section 3). Copy to .env.production ON THE SERVER ONLY.
# Every <...> value must be replaced; the app refuses to start otherwise.
APP_ENV="production"
APP_URL="<https://your-domain>"
APP_HOST="0.0.0.0"
APP_PORT="47320"
LOG_LEVEL="info"

# Must NOT end in _test
DATABASE_URL="<postgresql://user:password@db:5432/jdsheets>"
POSTGRES_PASSWORD="<database password>"

NETWORK_ENFORCEMENT="on"
TRUSTED_PROXY_HOPS="1"
# Caddy (the edge): the domain, and the networks allowed at all (SPACE-separated CIDRs)
SITE_ADDRESS="<sheets.your-domain>"
EDGE_ALLOWED_CIDRS="<office CIDRs, space-separated>"
BOOTSTRAP_ALLOWED_CIDRS="<office CIDRs, comma-separated>"

COLLAB_URL="http://collab:47321"
COLLAB_HOST="0.0.0.0"
COLLAB_PORT="47321"
# Generate each with: openssl rand -base64 48
COLLAB_TOKEN_SECRET="<random secret>"
INTERNAL_SERVICE_TOKEN="<random secret>"
AUTH_SECRET="<random secret>"
# The first Super Admin (private seed), used once and then removed from this file
SEED_SUPER_ADMIN_EMAIL="<name@jdfusion.in>"
SEED_SUPER_ADMIN_PASSWORD="<strong password>"

WORKBOOK_VALIDATOR="collab"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/data/workbooks"

MAIL_DRIVER="smtp"
# Gmail with an app password (Decision 60). The password may keep Google's spaces.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="<sending Gmail address>"
SMTP_PASSWORD="<Google app password>"
MAIL_FROM="<JD Sheets <sending Gmail address>>"
